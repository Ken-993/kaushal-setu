{
  // Flatpak VS Code runs in a sandbox: its normal terminal cannot see podman, git or gh
  // installed on Fedora. This profile opens the terminal on the real system instead.
  "terminal.integrated.profiles.linux": {
    "Fedora (host)": {
      "path": "/usr/bin/flatpak-spawn",
      // "script" gives the shell a real terminal, so Ctrl+C and job control work
      "args": ["--host", "--env=TERM=xterm-256color", "script", "-qc", "bash", "/dev/null"],
      "icon": "terminal-linux"
    }
  },
  "terminal.integrated.defaultProfile.linux": "Fedora (host)",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  }
}
